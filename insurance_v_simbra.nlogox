<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="false">
  <code><![CDATA[__includes ["consumers.nls" "reporters.nls" "companies.nls"]


globals [
  current-seed
   total-wealth  last-total-wealth mean-risk
  unlucky-mean-disaster-probability luck-mean-disaster-probability
  total-capital last-total-capital total-subsidy-cumulative
  capital-var mean-price steps-unlucky company-markup
  n-insured-consumers
  insured-mean-wealth uninsured-mean-wealth
  insured-median-wealth uninsured-median-wealth
  min-size max-size
  loss
  pending-capital-loss
]

breed [consumers consumer]
breed [companies company]

to setup
  let semente-temporaria current-seed 
  clear-all                           
  ifelse behaviorspace-run-number > 0 [
    set current-seed semente-temporaria
  ] [
    set current-seed new-seed
  ]
  random-seed current-seed
  
  reset-timer
  
  set last-total-wealth total-wealth
  set last-total-capital total-capital
  set total-subsidy-cumulative 0
  set company-markup 0
  set pending-capital-loss 0
  set n-insured-consumers 0

  create-consumers n-consumers [
    move-to one-of patches with [not any? consumers-here]
    determine-initial-wealth
    set initial_wealth wealth
    set shape "circle"
    set color green
    set insured? false
    determine-agent-type
    set n-disaster 0
    set min-size 0.5
    set max-size 4
    
  ]
  
  
  create-companies 1 [
    ask companies [hide-turtle]
  ]
  
  set total-wealth sum [wealth] of consumers
  set last-total-wealth total-wealth
  set loss (total-wealth / n-consumers)
  
  ask companies [
    ifelse capital_limit? 
      [set initial-capital .05 * total-wealth]
      [set initial-capital 1.0E+20]
    set capital initial-capital
  ]
  set total-capital sum [capital] of companies
  set last-total-capital total-capital
  calculate-means-risks
  determine-gamma
  
  if insurance-market? = true [ 
    ask consumers [
      determine-insurance-price
    ]
  ]
  
  set mean-price mean [price] of consumers
  ask consumers [
   set actual-risk mean-risk
  ]
  
  reset-ticks
end

to go
  if not any? companies [
    stop
  ]
  
  if company-strategies = "raise_price" [
    ask companies [
      company-raise-price
    ]
  ]
  
  ask consumers [
    set color green
    set disaster-occurred? false
    set insured? false
    set subsidy 0
    
    move-consumers
    if receive-salary?[
     receive-salary
    ]
    
    if wealth >= 1[
      transact 
    ]
  ]
 
  set total-wealth sum [wealth] of consumers
  set loss (total-wealth / n-consumers)
  
  ask consumers [
    if insurance-market? = true [
      determine-insurance-price
      
      if company-strategies = "historical-risk-update" [
        historical-risk
      ]

      ifelse wealth >= price and wealth > 0 [
        ifelse obligatory_insurance? 
          [buy-insurance]
          [decide-insurance]]
      [
        set insured? false
      ]
      
      if government? = true and  insured? = false
      and type-risk = subsidy-type[
        receive-subsidy
      ]
    ]
    
    if random-float 1 < risk [
      disaster-event
    ]
    if company-strategies = "history_disaster"[
      actualize-disaster-history
    ]
    actualize-consumer-size-visual
  ]
  
  ask companies[
    verify-capital
  ]
  
  set total-wealth sum [wealth] of consumers
  set total-capital sum [capital] of companies
  update-capital-var
  
  ifelse capital-var < 0 [
    set pending-capital-loss abs(total-capital - last-total-capital)
  ] [
    set pending-capital-loss 0
  ]
  
  set last-total-capital total-capital
  
  set mean-price mean [price] of consumers
  set total-subsidy-cumulative total-subsidy-cumulative + sum [subsidy] of consumers
  
  count-insured-consumers
  calculate-means-wealth

  if  insurance-market? = true and ticks > 0 and n-insured-consumers = 0 [
    stop
  ]
  
  tick
end


to disaster-event  
  let disaster-cost loss * (disaster-loss-perc / 100)
  set disaster-occurred? true
  set n-disaster n-disaster + 1
  
  ifelse insured? = true 
  [
    set color white
    ask one-of companies [
     set capital (capital - [disaster-cost] of myself)
    ]
  ]  
  [ 
    set wealth wealth - disaster-cost
    set color red
  ]
end

to actualize-disaster-history
  ifelse disaster-occurred? = true
    [set disaster-history lput 1 but-first disaster-history]
    [set disaster-history lput 0 but-first disaster-history]
end

to calculate-means-risks 
  set mean-risk mean [risk] of consumers
  set luck-mean-disaster-probability mean [risk] of consumers with [type-risk = "lucky"] 
  set unlucky-mean-disaster-probability mean [risk] of consumers with [type-risk = "unlucky"]
end

to calculate-means-wealth
  ifelse any? consumers with [insured?]
    [set insured-mean-wealth mean [wealth] of consumers with [insured?]
      set insured-median-wealth median [wealth] of consumers with [insured?] ]
    [set insured-mean-wealth 0
     set insured-median-wealth 0]
  ifelse any? consumers with [not insured?]
    [set uninsured-mean-wealth mean [wealth] of consumers with [not insured?]
     set uninsured-median-wealth median [wealth] of consumers with [not insured?]]
    [set uninsured-mean-wealth 0 
     set uninsured-median-wealth 0]
end

to update-capital-var

  if last-total-capital = 0 [
    set last-total-capital total-capital
    set capital-var 0
    stop
  ]

  let capital-delta (total-capital - last-total-capital)
  
  set capital-var
  (capital-delta / last-total-capital) * 100
  
  
end


to count-insured-consumers
  set n-insured-consumers count consumers with [insured?] 
end


]]></code>
