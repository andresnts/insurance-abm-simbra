    </plot>
    <slider x="158" step="1" y="549" max="100" width="150" display="k-credibility" height="50" min="1" direction="Horizontal" default="50.0" variable="k-credibility"></slider>
    <chooser x="6" y="517" height="60" variable="company-strategies" current="0" width="149" display="company-strategies">
      <choice type="string" value="None"></choice>
      <choice type="string" value="raise_price"></choice>
      <choice type="string" value="historical-risk-update"></choice>
    </chooser>
    <chooser x="805" y="488" height="60" variable="subsidy-type" current="1" width="100" display="subsidy-type">
      <choice type="string" value="unlucky"></choice>
      <choice type="string" value="lucky"></choice>
    </chooser>
    <slider x="694" step="10" y="551" max="100" width="216" display="subsidy-percentage" height="50" min="0" direction="Horizontal" default="70.0" variable="subsidy-percentage" units="%"></slider>
    <monitor x="417" precision="17" y="484" height="60" units="mean" fontSize="11" width="123" display="Insured Wealth">insured-mean-wealth</monitor>
    <monitor x="495" precision="17" y="546" height="60" units="median" fontSize="11" width="134" display="Uninsured Wealth">uninsured-median-wealth-report</monitor>
    <monitor x="356" precision="17" y="546" height="60" units="median" fontSize="11" width="137" display="Insured Wealth">insured-median-wealth-report</monitor>
    <monitor x="542" precision="17" y="424" height="60" fontSize="11" width="100" display="Price Mean">mean-price-reporter</monitor>
    <monitor x="442" precision="17" y="424" height="60" fontSize="11" width="100" display="Total Capital">total-capital-report</monitor>
    <monitor x="540" precision="17" y="484" height="60" units="mean" fontSize="11" width="122" display="Uninsured Wealth">uninsured-mean-wealth</monitor>
    <monitor x="317" precision="17" y="484" height="60" fontSize="11" width="100" display=" Gov Expenses">total-subsidy-report</monitor>
    <monitor x="342" precision="1" y="424" height="60" fontSize="11" width="100" display="Total wealth">wealth-report</monitor>
    <switch x="830" y="15" height="40" on="true" variable="capital_limit?" width="152" display="capital_limit?"></switch>
